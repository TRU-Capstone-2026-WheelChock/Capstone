@startuml
title Capstone Deployment ZMQ Topology

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

rectangle "center" as center {
  note as center_note
    Open / bind
    - SUB :5555
      receives SensorMessage
    - PUB :5556
      sends DisplayMessage
    - PUB :5557
      sends MotorMessage
  end note
}

rectangle "display" as display {
  note as display_note
    Receive only
    - connect center:5556
    - receives DisplayMessage
  end note
}

rectangle "motor" as motor {
  note as motor_note
    Receive
    - connect center:5557
    - receives MotorMessage

    Send
    - connect center:5555
    - sends HEARTBEAT / SensorMessage
  end note
}

rectangle "mock-override-button" as override {
  note as override_note
    Send only
    - connect center:5555
    - sends OVERRIDE_BUTTON / SensorMessage
  end note
}

rectangle "sensors" as sensors {
  rectangle "thermal publisher\n(service: publisher)" as thermal {
    note as thermal_note
      Send only
      - connect center:5555
      - sends SENSOR / SensorMessage
    end note
  }

  rectangle "mock-sensor-2" as sensor2 {
    note as sensor2_note
      Send only
      - connect center:5555
      - sends SENSOR / SensorMessage
    end note
  }

  rectangle "mock-sensor-3" as sensor3 {
    note as sensor3_note
      Send only
      - connect center:5555
      - sends SENSOR / SensorMessage
    end note
  }
}

override --> center : send to tcp://center:5555\nOVERRIDE_BUTTON / SensorMessage
sensor2 --> center : send to tcp://center:5555\nSENSOR / SensorMessage
sensor3 --> center : send to tcp://center:5555\nSENSOR / SensorMessage
thermal --> center : send to tcp://center:5555\nSENSOR / SensorMessage
motor --> center : send to tcp://center:5555\nHEARTBEAT / SensorMessage

center --> display : publish from :5556\nDisplayMessage
center --> motor : publish from :5557\nMotorMessage

@enduml
